{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenefitBridge catalog v1",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "description",
      "version",
      "priority",
      "conditions"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "version": {
        "type": "integer",
        "minimum": 1
      },
      "priority": {
        "type": "integer"
      },
      "conditions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attribute",
            "operator",
            "value",
            "explanation"
          ],
          "properties": {
            "attribute": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "enum": [
                "EQ",
                "GTE",
                "IN"
              ]
            },
            "value": {},
            "explanation": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "operator": {
                    "const": "GTE"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "number"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "operator": {
                    "const": "IN"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
